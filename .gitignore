# ============================================================
# KEYONE — root .gitignore
# ============================================================

# ----- Dependencies -----
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ----- Environment files (NEVER commit real secrets) -----
# Keep *.example files tracked; ignore everything else.
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
# .env.example  ← intentionally NOT listed: keep it tracked

# ----- Secrets & credentials (NEVER commit these) -----
.deployment-secrets.txt
*.secrets.txt
*.credentials.txt
*.token
*.key
!*.key.example

# ----- Databases -----
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.db.bak
*.db.backup-*

# ----- Sessions & ephemeral runtime state -----
sessions/
backups/
state/

# ----- WhatsApp cache/session files -----
.wwebjs_cache/
.wwebjs_auth/
.puppeteer-cache/
chrome-profile-*/

# ----- Build outputs -----
# Build artifacts must not be committed. Production builds on the VPS.
.next/
dist/
build/
out/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----- OS & editor -----
.DS_Store
._.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ----- TypeScript cache -----
*.tsbuildinfo

# ----- Test coverage -----
coverage/
.nyc_output/

# ----- VPS-only runtime artifacts in repository root (never commit these) -----
/*.tgz
/*.tar.gz
/app.tgz
/apply-*.ps1
/diag*.ps1
/diag*.py
/fix-*.ps1
/full-check.ps1
/ping-*.ps1
/restart-*.ps1
/revert-*.ps1
/run-*.ps1
/setup-app*.ps1
/setup-saas.ps1
/start-*.ps1
/test-*.ps1
/test-*.py
/bench-*.py
/check-bot.js
/check-state.py
/check-ts-runner.ps1
/finish-update.ps1
/install-*.ps1
/list-users.js
/worker-test.ps1
/seed-test-user.js
/_probe.cjs
*.bak
*.bak-*
saas-backup-*/
*.png
!public/**/*.png
!saas/public/**/*.png

# KEYONE Bridge (Go module) is vendored into this monorepo so it is versioned,
# pushed, and released alongside the Cloud. Ignore only its build artifacts +
# local runtime state (keyone-bridge/.gitignore covers the rest).
keyone-bridge/bin/
keyone-bridge/dist/
