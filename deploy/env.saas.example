####################################
# Next.js SaaS  -> C:\KEYONE\repo\saas\.env
####################################

# Public URL
NEXT_PUBLIC_SITE_URL="https://k1wb.app.keyone1.com"

# SQLite location (use absolute path on VPS)
DATABASE_URL="file:C:/KEYONE/data/saas.db"

# Session secret (generate a strong random string)
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_64_HEX_CHARS"

# LLM backend (CloakBrowser FastAPI service on the same VPS)
LLM_API_URL="http://127.0.0.1:7788"
LLM_API_KEY="change-secret-key-2026"
LLM_MODEL="gpt-4o-mini"

# WhatsApp Node service (same VPS)
WHATSAPP_SERVICE_URL="http://127.0.0.1:7799"
WHATSAPP_SHARED_SECRET="change-this-shared-secret"

# Experimental Baileys provider (isolated worker only; no production routing)
# Set ENABLE_BAILEYS=1 only during controlled test windows.
ENABLE_BAILEYS="0"
BAILEYS_WORKER_HEALTH_PORT="3025"
BAILEYS_AUTH_DIR="C:/KEYONE/data/baileys-exp-sessions"
BAILEYS_LOG_DIR="C:/KEYONE/logs/baileys"
BAILEYS_MAX_SESSIONS="1"
BAILEYS_MAX_RECONNECTS="5"
BAILEYS_AUTORESTORE="0"
BAILEYS_ALLOW_TEST_SEND="0"
# Optional hard gate for outgoing experimental test sends.
# BAILEYS_TEST_RECIPIENT="201000000000"

# Production runtime
NODE_ENV="production"
PORT="3000"
