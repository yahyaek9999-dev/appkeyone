####################################
# WhatsApp Puppeteer Service  ->  C:\KEYONE\repo\whatsapp-service\.env
####################################

# Bind
HOST="127.0.0.1"
PORT="7799"

# Shared secret to authorize requests from the Next.js side
SHARED_SECRET="change-this-shared-secret"

# Webhook back to Next.js (incoming messages + status events)
SAAS_WEBHOOK_URL="http://127.0.0.1:3000/api/whatsapp/incoming"

# Session storage location
SESSIONS_DIR="C:/KEYONE/data/wa-sessions"

# Experimental Baileys provider (isolated worker only; no production routing)
# Must remain disabled except during controlled test windows.
ENABLE_BAILEYS="0"
BAILEYS_WORKER_HEALTH_PORT="3025"
BAILEYS_AUTH_DIR="C:/KEYONE/data/baileys-exp-sessions"
BAILEYS_LOG_DIR="C:/KEYONE/logs/baileys"
BAILEYS_MAX_SESSIONS="1"
BAILEYS_MAX_RECONNECTS="5"
BAILEYS_AUTORESTORE="0"
BAILEYS_ALLOW_TEST_SEND="0"

# Headless mode
HEADLESS="true"
