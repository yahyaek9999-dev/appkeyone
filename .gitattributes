# KEYONE repository line-ending rules
# Keep source files stable across macOS/Linux/Windows and avoid dirty VPS checkouts.

* text=auto eol=lf

# Windows scripts may stay CRLF-friendly when edited on Windows.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
