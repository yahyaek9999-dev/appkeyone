# ============================================================
# KEYONE SaaS — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================
# How to generate secrets:
#   AUTH_SECRET           : openssl rand -hex 32
#   SAAS_INTERNAL_SECRET  : openssl rand -hex 24
#   WHATSAPP_SHARED_SECRET: openssl rand -hex 24
#   ADMIN_INIT_SECRET     : openssl rand -hex 32
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://wkeyone.app
# Number of trusted reverse proxies in front of the app (Caddy = 1). Used by the
# rate limiter to pick the real client IP from X-Forwarded-For and ignore the
# attacker-appendable leftmost entries. Set to your actual proxy hop count.
TRUSTED_PROXY_COUNT=1

# --- Auth ---
# 64 hex chars. Used to sign session JWTs AND as the AES-256-GCM key
# for encrypting merchant AI provider keys at rest. MUST be >= 32 chars.
AUTH_SECRET=

# --- Database (SQLite - current production) ---
# Use absolute path on the VPS (Windows: file:C:/app/data/saas.db)
DATABASE_URL=file:./prisma/prod.db

# --- Database (Postgres - Supabase - migration target) ---
# Uncomment and fill in when migrating away from SQLite.
# POSTGRES_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# POSTGRES_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Redis (Upstash) ---
# Required when ENABLE_BULLMQ=1 or for distributed rate-limiting.
UPSTASH_REDIS_REST_URL=https://YOUR_CLUSTER.upstash.io
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=rediss://default:[PASSWORD]@YOUR_CLUSTER.upstash.io:6379

# --- LLM ---
# In-house LLM proxy (CloakBrowser FastAPI on same VPS).
# Comma-separate multiple URLs for round-robin: LLM_API_URLS=http://127.0.0.1:7788,http://127.0.0.1:7789
LLM_API_URL=http://127.0.0.1:7788
LLM_API_URLS=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONCURRENT=3

# --- WhatsApp Service ---
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
# Shared secret between saas <-> whatsapp-service. Must match whatsapp-service .env.
SAAS_INTERNAL_SECRET=
WHATSAPP_SHARED_SECRET=

# Required to use the POST /api/admin/init recovery endpoint. Leave UNSET to keep
# that endpoint disabled (it returns 403 when unset). >= 32 chars in production.
ADMIN_INIT_SECRET=

# --- Sentry (Error Tracking) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=keyone
SENTRY_PROJECT=keyone
# sntryu_... token from https://sentry.io → Account Settings → API → Auth Tokens
SENTRY_AUTH_TOKEN=

# --- Meta Cloud API (optional) ---
# Set META_CLOUD_ENABLED=1 only after Meta app approval and full configuration.
META_CLOUD_ENABLED=0
META_APP_SECRET=
META_GRAPH_VERSION=v20.0

# --- Media / Vision (optional) ---
# Leave empty to use graceful no-op fallbacks for audio transcription + vision.
OPENAI_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=gpt-4o-mini

# --- Anti-ban tuning (optional - sensible defaults built-in) ---
# ANTI_BAN_PER_MIN=12
# ANTI_BAN_PER_10M=80
# ANTI_BAN_NEW_CHATS_10M=25
# ANTI_BAN_DAILY_SOFT_CAP=600
# ANTI_BAN_COOLDOWN_MS=90000

# --- Cache tuning (optional) ---
# KB_CACHE_TTL_MS=60000
# KB_CACHE_MAX=256
# MEMORY_EXTRACT_EVERY=20
# MEMORY_EXTRACT_TIMEOUT_MS=25000

# --- Feature flags ---
# Set ENABLE_BULLMQ=1 when a dedicated BullMQ worker process is running
# (requires UPSTASH_REDIS_URL to be configured).
ENABLE_BULLMQ=0

# Free-tier enforcement master switch (revenue protection).
# When =1, users with NO active subscription (or an expired one) are limited to
# CORE features only; premium pages/routes show an upgrade prompt instead of
# being silently free. Active legacy-slug AND k_* subscribers are unaffected.
# Keep =0 until go-live, then flip to =1 AFTER confirming every active paying
# customer has a Subscription row (see project-knowledge gating report).
FREE_TIER_ENFORCEMENT=0

# --- Seed / Setup (only used by prisma/seed.ts - not at runtime) ---
# ADMIN_EMAIL=admin@keyone1.com
# ADMIN_PASSWORD=ChangeMe!2026
# SUPPORT_WHATSAPP=+201000000000
# SUPPORT_EMAIL=support@keyone1.com
