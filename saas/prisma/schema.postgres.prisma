generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")           // pooled connection (PgBouncer via Supabase)
  directUrl = env("POSTGRES_DIRECT_URL")    // direct connection (migrations, setup)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  role         String   @default("user") // user | admin
  createdAt    DateTime @default(now())

  // ---- Self-service signup approval (Launch: waitlist-gated signup) ----
  // Public signups land as "pending" and an admin approves them before they
  // can log in. Default "approved" keeps every existing row (and admin-created
  // users) usable without a data migration. Flip SIGNUP_AUTO_APPROVE=1 to make
  // signups self-activate.
  approvalStatus String   @default("approved") // pending | approved | rejected
  approvedAt     DateTime?
  approvedBy     String?

  // ---- Membership: account suspension (Phase: membership foundation) ----
  // Suspended users keep their data but cannot send/receive WA messages,
  // run AI requests, or send broadcasts. Reactivation is admin-only.
  // Default false ensures existing users are unaffected by the migration.
  suspended       Boolean  @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  // ---- Knowledge Brain: paid add-on gate (Phase 5) ----
  // OFF by default; a platform admin enables it per tenant. Additive, nullable
  // default so existing users are unaffected by the migration.
  knowledgeBrainEnabled Boolean @default(false)

  bot            Bot?
  subscription   Subscription?
  teamMembers    TeamMember[] @relation("TeamOwner")
  customers      Customer[]
  documents      Document[]
  apiCalls       ApiCall[]
  broadcasts     Broadcast[]
  knowledgeGaps  KnowledgeGap[]
  orders         Order[]
  commerceIntegrations CommerceIntegration[]
  commerceWebhookEvents CommerceWebhookEvent[]
  commerceAutomations CommerceAutomation[]
  commerceNotifications CommerceNotificationLog[]
  commerceEmailProviders CommerceEmailProvider[]
  commerceEmailTemplates CommerceEmailTemplate[]

  // ---- Phase 3: premium modules (additive, new tables only) ----
  flowDefinitions  FlowDefinition[]
  branches         Branch[]
  approvalRequests ApprovalRequest[]
  whiteLabel       WhiteLabelConfig?
  upgradeRequests  UpgradeRequest[]
}

/// Team members who can log into a workspace under the OWNER's account with a
/// scoped role. The owner is the original User; members authenticate with their
/// own email + password but every query still scopes to `ownerId` (= the
/// owner's User.id), so data isolation is unchanged. Replaces the legacy
/// Bot.teamMembersJson blob (which is kept for backward-compat but unused).
model TeamMember {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  role            String   @default("viewer") // admin | sales | support | viewer
  passwordHash    String?                      // null until the invite is accepted
  status          String   @default("invited") // invited | active | disabled
  inviteTokenHash String?  @unique             // sha256 of the raw invite token
  inviteExpiresAt DateTime?
  invitedAt       DateTime @default(now())
  acceptedAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ownerId, email])
  @@index([ownerId])
  @@index([email])
}

model Bot {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String   @default("المساعد الذكي")
  persona         String   @default("ودود ومحترف")
  systemPrompt    String   @default("أنت مساعد المبيعات الرسمي للشركة. تكلم بالعربية باحترام واختصار. اعرض الخدمات والأسعار بدقة من معلومات الشركة المتوفرة فقط، ولا تخترع أي سعر. لو العميل أبدى نية شراء أو سأل عن طريقة الاشتراك أو الدفع، اطلب اسمه ورقم واتسابه ووجّهه يتواصل مع رقم الإدارة لإتمام التفعيل. لو السؤال خارج معلوماتك، اعتذر بصراحة واطلب التواصل مع الإدارة.")
  welcomeMessage  String   @default("أهلاً بك! كيف يمكنني مساعدتك؟")
  notifyPhone     String?  // Phone to receive order/payment alerts
  orderKeywords   String   @default("اوردر,طلب,حولت,تحويل,دفعت,انستاباي,فودافون كاش,فيزا,ايصال")
  whatsappStatus  String   @default("disconnected") // disconnected | connecting | connected
  whatsappPhone   String?

  // ---- Working hours & out-of-office ----
  workingHoursEnabled Boolean @default(false)
  workingHours        String  @default("[]")  // JSON: [{day:0..6, from:"09:00", to:"21:00", enabled:true}]
  outOfHoursMessage   String  @default("شكراً لتواصلك! فريقنا متاح من 9 صباحاً حتى 9 مساءً. هنرد عليك أول ما نرجع. 🙏")
  alertEnabled        Boolean @default(true)  // anger alerts on/off
  followUpsEnabled    Boolean @default(true)
  followUpHours       Int     @default(24)    // wait this many hours before nudging

  // ---- Production escalation / human handoff controls ----
  escalationAutoPause        Boolean @default(true)   // severe tickets pause AI until admin takes over
  escalationEmailEnabled     Boolean @default(false)  // optional email alert via configured email provider
  escalationConfidenceFloor  Int     @default(35)     // below this confidence, repeated failures escalate

  // ---- Follow-up safety controls ----
  followUpMaxPerCustomer     Int     @default(2)      // hard anti-spam cap per customer
  followUpQuietHoursStart    Int?                    // optional local quiet-hour start (0..23)
  followUpQuietHoursEnd      Int?                    // optional local quiet-hour end (0..23)

  // ---- Order/customer notification controls ----
  orderStatusNotifyEnabled   Boolean @default(false)  // opt-in WhatsApp updates beyond shipment-only template
  // IANA timezone used for working hours, daily-report scheduling, and any
  // local-hour computation. Default = Africa/Cairo (project's home market).
  // Existing rows get the default automatically via prisma db push.
  timezone            String  @default("Africa/Cairo")

  // ---- Human simulation (Wave 5) ----
  humanizeReplies     Boolean @default(false)  // master switch for all human-like behaviors
  typingSpeedCps      Int     @default(25)     // chars per second (used for typing delay calc)
  dynamicEmojis       Boolean @default(true)   // sprinkle context-appropriate emojis
  replyVariations     Boolean @default(true)   // higher temperature + variety hint
  preReplyDelayMs     Int     @default(800)    // small "reading" pause before typing starts

  // ---- Sales intelligence (Wave 7) ----
  negotiationEnabled  Boolean @default(false)
  negotiationFloorPct Int     @default(10)     // max % off the listed price the bot may offer
  persuasionEnabled   Boolean @default(true)   // urgency/scarcity hints when intent=buy

  // ---- Wave 12: response cache (exact-text 24h) ----
  cacheEnabled    Boolean  @default(true)      // cache identical customer questions for 24h
  cacheTtlHours   Int      @default(24)        // 1..168

  // ---- Daily safety cap (Controlled Launch) ----
  // Per-bot daily ceiling on assistant replies. 0 = disabled (falls back to
  // the monthly plan cap only). Counter is reset by the request path when
  // `dailyMsgsResetAt` is before "today 00:00 UTC".
  dailyMessageCap Int      @default(0)
  dailyMsgsUsed   Int      @default(0)
  dailyMsgsResetAt DateTime @default(now())

  // ---- Multi-provider AI (Phase: Provider Router) ----
  // Default "keyone" keeps existing behavior (calls the in-house mse_ai_api).
  // When set to a third-party provider, the merchant supplies an API key
  // (encrypted at rest) and an optional model override. All upstream caching,
  // realism, anti-ban, sales, memory, and quick-reply layers continue to run
  // unchanged — only the text-generation source is swapped.
  aiProvider      String   @default("keyone")  // keyone | openai | gemini | openrouter | claude | groq
  aiApiKeyEnc     String?                       // AES-256-GCM ciphertext of the merchant's API key
  aiModel         String?                       // optional per-bot model override (provider-specific)

  // ---- Daily AI Business Report (Wave: revenue intelligence) ----
  // Sends one Arabic WhatsApp summary per day to the merchant's notifyPhone
  // (or whatsappPhone fallback). Heuristic-only by default — no LLM tokens.
  dailyReportEnabled   Boolean  @default(true)
  dailyReportHour      Int      @default(9)        // 0..23, merchant local hour to send
  dailyReportLastSentAt DateTime?                  // dedupe guard within a single calendar day

  // ---- WhatsApp connection mode (Hybrid Phase 1) ----
  // Accepted values (both old + new are normalized by `lib/messaging/mode.ts`):
  //   "qr"          → whatsapp-web.js gateway (legacy alias: "unofficial")
  //   "meta_cloud"  → Meta Cloud API (legacy alias: "official")
  // Default stays "qr" so every existing row keeps its current behavior.
  // The provider factory NEVER routes to Meta until ALL of these are true:
  //   1. `connectionMode == "meta_cloud"`
  //   2. global flag `META_CLOUD_ENABLED=1`
  //   3. merchant plan allows it (Pro=QR-only, Max=hybrid, Companies=full)
  //   4. `metaAccessTokenEnc` is set + verified
  connectionMode  String   @default("qr")  // qr | meta_cloud (legacy: unofficial | official)

  // ---- Meta Cloud API configuration (Phase 1 schema, Phase 2 runtime) ----
  // All token storage is AES-256-GCM encrypted via lib/crypto.ts. Empty by
  // default — QR mode never reads these fields. The webhook verify token is
  // a merchant-chosen random string sent back to Meta during webhook setup.
  metaPhoneNumberId       String?  // Meta Cloud API phone_number_id
  metaBusinessAccountId   String?  // WABA id (waba_id)
  metaAccessTokenEnc      String?  // encrypted Cloud API access token
  metaAppSecretEnc        String?  // encrypted app secret (for X-Hub-Signature-256 verification)
  metaWebhookVerifyToken  String?  // merchant-chosen token used during webhook handshake
  metaQualityRating       String?  // GREEN | YELLOW | RED — last seen on Meta dashboard
  metaMessagingLimit      String?  // TIER_50 | TIER_250 | TIER_1K | TIER_10K | TIER_UNLIMITED
  metaVerifiedAt          DateTime? // first successful health check timestamp

  // ---- Per-business customization (Issue #6) ----
  // Adapts the system prompt + automations to the merchant's industry. The
  // default "store" preserves current behavior so existing rows stay
  // identical until the merchant opts into another mode.
  businessMode    String   @default("store")  // store | restaurant | real_estate | services | custom

  // ---- Shipment notification (Issue #7) ----
  // Optional opt-in messaging to customers when their order changes to
  // status="shipped". Disabled by default to avoid surprise outbound traffic.
  shipmentNotifyEnabled  Boolean @default(false)
  shipmentNotifyTemplate String  @default("📦 طلبك في الطريق إليك! رقم التتبع: {tracking}. شكراً لاختيارك {shop}.")
  // ---- Growth Suite: per-status shipping templates (JSON status→text). Empty
  // {} → use built-in Arabic defaults. Master toggle reuses orderStatusNotifyEnabled.
  shippingTemplates      String  @default("{}")

  // ---- Policy grounding (Issue #11) ----
  // Free-form merchant-authored rules ("لا نوفر شحن للمحافظات", "أقل سعر للجملة 50",
  // "لا نتعامل بالدولار"...). Injected into the system prompt VERBATIM so the
  // AI never invents promises that contradict company policy.
  policyRules     String   @default("")

  // ---- Abandoned-cart recovery (Agent 3, Task #7) ----
  // OFF by default — opt-in only. When enabled, the abandoned-cart cron may
  // queue ONE recovery follow-up (via the protected queueSmartFollowUp path)
  // for customers whose cart went stale without an order. Honors opt-out,
  // subscription, follow-up caps, and pacing exactly like every other send.
  abandonedCartEnabled     Boolean @default(false)
  abandonedCartDelayHours  Int     @default(4)   // wait this long after cartUpdatedAt before reminding
  abandonedCartWindowHours Int     @default(24)  // ignore carts older than this (avoid reminding ancient interest)

  // ---- Order extraction controls ----
  orderExtractionEnabled     Boolean @default(true)
  orderConfidenceThreshold   Int     @default(50)
  orderRequireProduct        Boolean @default(false)
  orderRequireConfirmation   Boolean @default(false)

  // ---- Team members (Phase 1: role registry, Phase 2: login enforcement) ----
  teamMembersJson String   @default("[]") // JSON: [{email,role,addedAt}]

  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  quickReplies    QuickReply[]
  llmCacheEntries LlmCache[]
}

/// Exact-match response cache. Stores the LLM's own answer to identical
/// customer questions, scoped per-bot, with a TTL. NO answer is invented or
/// edited — we just replay the previous LLM-generated reply.
model LlmCache {
  id         String   @id @default(cuid())
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  qHash      String                                    // sha256(normalized question)
  question   String                                    // raw question (debug + introspection)
  response   String                                    // verbatim LLM response
  hits       Int      @default(0)                     // how many times this was reused
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  @@unique([botId, qHash])
  @@index([botId, expiresAt])
}

/// Admin-defined Q→A pairs. We try cheap keyword matching first to skip LLM
/// and cut cost. Falls back to LLM if no template matches.
model QuickReply {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  triggers  String   // JSON array of trigger keywords/phrases (lowercased)
  reply     String   // the canned response
  enabled   Boolean  @default(true)
  hits      Int      @default(0)   // how many times this matched
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId, enabled])
}

model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameEn      String   @default("")
  priceUsd    Int      // monthly price in USD
  yearlyUsd   Int?     // yearly price (optional discount)
  monthlyMsgs Int
  features    String   // JSON array of feature strings
  description String   @default("")
  highlight   String?  // e.g. "الأكثر طلباً"
  popular     Boolean  @default(false)
  sortOrder   Int      @default(0)

  // ---- Membership foundation: granular limits + feature flags ----
  // All fields are additive with safe defaults so existing plans keep working
  // unchanged. Use the seed-defaults helper to populate values for the
  // canonical Pro/Max/Companies tiers at deploy time.
  tier              String  @default("basic")   // basic | pro | max | companies (display group)
  aiRequestsMonthly Int     @default(0)         // 0 = unlimited
  broadcastsMonthly Int     @default(0)         // 0 = unlimited
  whatsappSessions  Int     @default(1)         // simultaneous WA numbers allowed
  metaAccess        String  @default("none")    // none | limited | full
  analyticsAccess   String  @default("basic")   // basic | advanced
  queuePriority     Int     @default(0)         // higher = earlier in queue
  rateLimitPerMin   Int     @default(60)        // per-user incoming msg rate
  featureFlags      String  @default("{}")      // JSON: { broadcasts:true, templates:false, ... }

  subscriptions Subscription[]
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id])
  status      String   @default("pending") // pending | active | expired | canceled
  billingCycle String  @default("monthly") // monthly | yearly
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  msgsUsed    Int      @default(0)
  paymentRef  String?  // WhatsApp transfer reference / receipt
  adminNote   String?  // Admin internal notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Membership usage counters ----
  // Roll over monthly via the rolling-reset helper in lib/membership/limits.ts.
  // 0 in the matching Plan field = unlimited (we never block).
  aiRequestsUsed Int       @default(0)
  broadcastsUsed Int       @default(0)
  usageResetAt   DateTime?
}

model ApiCall {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   // e.g. /api/chat
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Customer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String   // WhatsApp number of the end-customer
  name        String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  // ---- Sales intelligence (computed by LLM + heuristics) ----
  leadScore       Int       @default(0)      // 0-100, recomputed after every msg
  lastIntent      String?                    // buy | inquiry | complaint | support | greeting | other
  lastSentiment   String?                    // positive | neutral | negative | angry
  tags            String    @default("[]")   // JSON array of tags
  followUpAt      DateTime?                  // when the cron should send a nudge
  followUpSent    Boolean   @default(false)
  followUpCount   Int       @default(0)      // immutable-ish anti-spam counter for sent followups
  optedOutAt      DateTime?                  // customer asked not to receive nudges
  notes           String?                    // admin's private notes about this customer

  // ---- Escalation / emotional intelligence rollups ----
  frustrationScore Int      @default(0)       // 0-100 latest rolling frustration score
  lastEscalationAt DateTime?

  // ---- Customer 360 CRM (additive, nullable/defaults — existing rows unaffected) ----
  vip             Boolean   @default(false)  // admin-flagged VIP
  blacklisted     Boolean   @default(false)  // admin-flagged blacklist
  archivedAt      DateTime?                  // admin-archived (hidden from active views)
  assignedAdmin   String?                    // free-text staff label handling this customer
  photoUrl        String?                    // profile photo URL (null → initials avatar)

  // ---- Smart personalization (Wave 9) ----
  preferences     String    @default("{}")   // JSON: { products:[], sizes:[], colors:[], budget?:number, lastTopics?:[] }
  purchaseProb    Int       @default(0)      // 0-100 estimated buy probability (Wave 8 predictive)
  bestHourLocal   Int?                       // best hour-of-day (0-23) to message this customer

  // ---- Cart abandonment (Wave 8) ----
  cartItems       String    @default("[]")   // JSON list of items the customer asked about
  cartUpdatedAt   DateTime?
  cartReminderSent Boolean  @default(false)

  // ---- Phase A: Conversion scoring ----
  conversionScore  Int      @default(0)   // 0-100 AI-derived conversion probability
  hesitationScore  Int      @default(0)   // 0-100 buyer hesitation level

  // ---- Phase F: Retention & loyalty ----
  retentionScore   Int      @default(50)  // 0-100 retention likelihood
  loyaltyScore     Int      @default(0)   // 0-100 loyalty based on repeat orders
  churnRiskScore   Int      @default(0)   // 0-100 churn risk (higher = more at risk)
  lastEngagedAt    DateTime?              // last time customer sent a message
  lastOrderAt      DateTime?              // timestamp of most recent order
  totalOrderValue  Int      @default(0)   // cumulative order total (EGP)
  orderCount       Int      @default(0)   // total confirmed orders

  // ---- Contact Trust System (Safety Wave) ----
  // Trust accrues with healthy two-way conversation. Used by the safety
  // engine to decide which contacts can safely receive higher-frequency
  // messaging vs. cold outbound that needs strict throttling.
  trustScore       Int       @default(50)    // 0-100, starts neutral
  engagementScore  Int       @default(0)     // 0-100, weighted by reply frequency
  inboundCount     Int       @default(0)
  outboundCount    Int       @default(0)
  firstInboundAt   DateTime?                  // null = bot wrote first (cold) → low trust
  // KEYONE activation: imported/historical chats stay visible but do not
  // start billing/safety/warmup until the first live runtime inbound.
  keyoneActivatedAt DateTime?
  firstLiveInboundAt DateTime?
  historicalImported Boolean @default(false)
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  blockedAt        DateTime?                  // set when WA reports a block / send fail final
  reportedAt       DateTime?                  // set when WA reports the contact reported us

  conversation Conversation?
  memory       CustomerMemory?
  orders       Order[]

  @@unique([userId, phone])
  @@index([userId])
  @@index([userId, leadScore])
  @@index([followUpAt])
  @@index([optedOutAt])
  @@index([userId, retentionScore])
  @@index([userId, lastEngagedAt])
  @@index([userId, keyoneActivatedAt])
  @@index([createdAt])                    // analytics: cohort analysis (funnel, segments)
}

/// Phase 1 — Memory Engine. One row per Customer. Stores a rolling Arabic
/// summary of the conversation + an extracted, structured "facts" JSON
/// (favorite products, sizes, budget, objections, ...). Updated in the
/// background every ~20 messages so the LLM prompt stays compact while the
/// bot still "remembers" everything important. Backward compatible with the
/// existing Customer.preferences field (we keep mirroring there).
model CustomerMemory {
  id                       String   @id @default(cuid())
  customerId               String   @unique
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  summary                  String   @default("")     // short Arabic rolling summary
  factsJson                String   @default("{}")   // structured extracted facts (Phase 1)
  lastSummarizedMessageId  String?                   // last msg id included in summary
  messageCount             Int      @default(0)      // total msgs seen by extractor
  pendingSinceMessageId    String?                   // first msg id queued since last extract
  pendingCount             Int      @default(0)      // msgs queued since last extract

  // ---- Phase C: Memory quality ----
  memoryConfidence  Int    @default(50)         // 0-100 confidence in memory accuracy
  sentimentHistory  String @default("[]")       // JSON: last 10 sentiments [{s:"positive",ts:1234}]
  cleanedAt         DateTime?                   // last time stale facts were pruned

  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())
}

model Conversation {
  id          String    @id @default(cuid())
  customerId  String    @unique
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  summary     String?   // rolling summary for long conversations
  botPaused   Boolean   @default(false)   // manual takeover by admin

  // ---- Human handoff state machine ----
  // ai_active -> escalation_pending -> human_required -> human_active -> ai_active
  handoffState       String    @default("ai_active")
  handoffReason      String?
  escalationTicketId String?
  lastEscalatedAt    DateTime?
  humanActiveAt      DateTime?

  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  messages    Message[]
  orders      Order[]

  @@index([handoffState])
  @@index([lastEscalatedAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String   // user | assistant | system | tool | admin
  content         String
  mediaType       String?  // text | voice | image
  mediaUrl        String?
  flagged         Boolean  @default(false) // order/payment detected
  // ---- per-message classification (only on user msgs) ----
  intent          String?
  sentiment       String?
  createdAt       DateTime @default(now())

  providerMessageId String?  // upstream WhatsApp/Meta id for duplicate-event protection
  angerScore         Int      @default(0)
  confidenceScore    Int      @default(100)
  frustrationScore   Int      @default(0)
  urgencyScore       Int      @default(0)
  emotionalTone      String?
  metadataJson       String   @default("{}")

  @@index([conversationId, createdAt])
  @@unique([conversationId, providerMessageId])
  @@index([createdAt])                    // analytics: date-range queries (funnel, forecast)
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   // raw text
  source    String   @default("manual") // manual | url | pdf | docx | suggestion
  sourceUrl String?  // origin URL if crawled

  // ---- Smart knowledge ranking ----
  priorityScore Int       @default(0)       // admin/AI assisted rank boost
  hitCount      Int       @default(0)       // retrieval/match telemetry
  lastMatchedAt DateTime?
  lastSuggestedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, priorityScore])
}

/// Broadcast campaigns: an admin queues a message that should fan out to many
/// customers. A worker (cron) drains it slowly to avoid WhatsApp rate limits.
model Broadcast {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  template      String                 // body, may contain {name} {phone}
  audience      String    @default("all")  // all | hot | warm | buyers | no_purchase | inactive | abandoned | date_range | tag:<tag>
  personalize   Boolean   @default(false)  // ask LLM to gently personalize per recipient (default OFF = exact mode for safety)
  status        String    @default("queued")  // queued | sending | done | canceled
  total         Int       @default(0)
  sent          Int       @default(0)
  failed        Int       @default(0)
  // ---- Smart Campaigns (additive, nullable — existing rows unaffected) ----
  kind          String    @default("campaign") // campaign | recovery
  scheduledAt   DateTime?                       // null = send immediately; else cron holds until <= now
  couponCode    String?                         // appended to body AFTER personalization
  imageUrl      String?                         // appended as a link (WhatsApp auto-previews); no media upload
  startedAt     DateTime?
  finishedAt    DateTime?
  // ---- A/B testing (additive, nullable — existing rows unaffected) ----
  abGroupId     String?                         // links the two variants of one A/B test
  abVariant     String?                         // "A" | "B" — null for normal campaigns
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         BroadcastItem[]

  @@index([userId, status])
  @@index([status, scheduledAt])
  @@index([userId, abGroupId])
}

/// Recovery suggestions the merchant explicitly dismissed, so the Recovery
/// view stops surfacing them. Detection itself stays in lib/intel/*.
model RecoveryDismissal {
  id         String   @id @default(cuid())
  userId     String
  customerId String
  kind       String   // lost_customer | follow_up_op
  createdAt  DateTime @default(now())

  @@unique([userId, customerId, kind])
  @@index([userId])
}

model BroadcastItem {
  id            String     @id @default(cuid())
  broadcastId   String
  broadcast     Broadcast  @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId    String
  phone         String
  name          String?
  status        String     @default("pending")  // pending | sent | failed | skipped
  error         String?
  sentAt        DateTime?

  @@index([broadcastId, status])
  @@index([customerId, status])            // Customer 360: timeline shows received broadcasts
}

/// Logs unanswerable questions. When the bot tells the user "I don't know",
/// we save the prompt here so the admin can convert it into knowledge.
model KnowledgeGap {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String?
  question       String
  conversationId String?
  occurrences    Int      @default(1)
  resolved       Boolean  @default(false)
  resolvedAt     DateTime?

  // Dynamic ranking metadata for the dashboard suggestion queue.
  score          Int      @default(0)
  lastIntent     String?
  lastSentiment  String?
  productHint    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, resolved])
  @@index([userId, occurrences])
}

// ---------------------------------------------------------------------------
// Internal Orders System.
//
// Orders are auto-extracted from WhatsApp conversations by a lightweight
// regex-first pipeline (lib/order-extractor). Confidence is recorded so the
// merchant knows which extractions to double-check. Items + timeline are
// additive and optional — old data continues to work.
// ---------------------------------------------------------------------------
model Order {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId    String?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // ---- Snapshot of the customer at the moment of capture ----
  customerName      String?
  customerPhone     String?
  shippingAddress   String?       // free text — fed by the customer over chat
  // ---- Money ----
  subtotal          Int           @default(0) // store as integer (smallest unit / EGP)
  shipping          Int           @default(0)
  discount          Int           @default(0)
  total             Int           @default(0)
  currency          String        @default("EGP")
  paymentMethod     String?       // "cod" | "instapay" | "vodafone_cash" | "card" | ...
  // ---- Lifecycle ----
  status            String        @default("pending")    // pending | confirmed | preparing | shipped | out_for_delivery | delivered | canceled
  fulfillmentStatus String        @default("unfulfilled") // unfulfilled | partial | fulfilled
  shippingStatus    String        @default("not_started") // not_started | preparing | shipped | delayed
  deliveryStatus    String        @default("not_started") // not_started | out_for_delivery | delivered | failed
  trackingCode      String?
  trackingUrl       String?
  courierName       String?
  lastNotifiedStatus String?
  lastCustomerNotifiedAt DateTime?
  // ---- Extraction quality ----
  aiConfidence      Int           @default(0) // 0-100; <50 = please review
  aiNotes           String?       // short Arabic note from the extractor
  source            String        @default("auto") // auto | manual
  commerceIntegrationId String?
  commerceIntegration   CommerceIntegration? @relation(fields: [commerceIntegrationId], references: [id], onDelete: SetNull)
  externalSource    String?
  externalOrderId   String?
  externalOrderName String?
  externalPayload   String        @default("{}")
  // ---- Misc ----
  flaggedReason     String?       // why merchant flagged it (optional)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items     OrderItem[]
  timeline  OrderTimeline[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([customerId])
  @@index([commerceIntegrationId])
  @@index([userId, status, total])            // analytics: revenue aggregation
  @@unique([userId, externalSource, externalOrderId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String                  // free text — "قميص قطن أزرق"
  size        String?
  color       String?
  quantity    Int      @default(1)
  unitPrice   Int      @default(0)
  lineTotal   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String                  // created | status_changed | note | reminder_sent | payment | ai_extracted
  payload   String   @default("{}") // JSON
  message   String?                  // human-readable Arabic line for the UI
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model CommerceIntegration {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  platform        String   @default("custom")
  enabled         Boolean  @default(true)
  apiKeyHash      String   @unique
  apiKeyPrefix    String
  webhookSecretEnc String
  configJson      String   @default("{}")
  setupMode       String   @default("api_key") // api_key | native_webhook | oauth
  storeUrl        String?
  connectionStatus String  @default("untested") // untested | healthy | degraded | failed
  lastSyncStatus  String?
  lastSyncAt      DateTime?
  lastSyncError   String?
  nativeWebhookSecretEnc String?
  lastTestAt      DateTime?
  lastEventAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders      Order[]
  events      CommerceWebhookEvent[]
  automations CommerceAutomation[]

  @@index([userId, enabled])
  @@index([userId, platform])
}

model CommerceWebhookEvent {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId     String
  integration       CommerceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  source            String
  eventType         String
  externalEventId   String
  externalOrderId   String?
  payloadHash       String
  rawPayload        String
  normalizedPayload String   @default("{}")
  signatureOk       Boolean  @default(false)
  status            String   @default("received")
  attempts          Int      @default(0)
  lastError         String?
  receivedAt        DateTime @default(now())
  processedAt       DateTime?

  @@unique([integrationId, externalEventId])
  @@index([userId, receivedAt])
  @@index([integrationId, status, receivedAt])
  @@index([userId, status, receivedAt])
}

model CommerceAutomation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId String?
  integration   CommerceIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType     String
  channel       String
  enabled       Boolean  @default(false)
  subject       String   @default("")
  template      String   @default("")
  language      String   @default("ar")
  throttleSeconds Int    @default(300)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, integrationId, eventType, channel, language])
  @@index([userId, enabled])
  @@index([integrationId, eventType])
}

model CommerceNotificationLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId String?
  orderId       String?
  eventId       String?
  eventType     String
  channel       String
  provider      String   @default("")
  recipient     String
  subject       String   @default("")
  body          String   @default("")
  status        String   @default("queued")
  attempts      Int      @default(0)
  idempotencyKey String  @unique
  error         String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([nextAttemptAt])
}

model CommerceEmailProvider {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("smtp")
  enabled     Boolean  @default(false)
  fromName    String   @default("")
  fromEmail   String   @default("")
  host        String   @default("")
  port        Int      @default(587)
  username    String   @default("")
  secretEnc   String?
  configJson  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId, enabled])
}

model CommerceEmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  language  String   @default("ar")
  subject   String
  html      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventType, language])
  @@index([userId, enabled])
}

// ---------------------------------------------------------------------------
// Production Intelligence: escalation, immutable usage, follow-ups, reports,
// and protection logs. These tables are append-first and do not cascade from
// Customer/Conversation on purpose, so billing and escalation history survive
// chat deletion and account-level audit remains durable.
// ---------------------------------------------------------------------------
model EscalationTicket {
  id                  String   @id @default(cuid())
  userId              String
  customerId          String
  conversationId      String
  status              String   @default("open") // open | acknowledged | human_active | resolved | dismissed
  handoffState        String   @default("escalation_pending")
  severity            String   @default("medium") // low | medium | high | critical
  reason              String
  trigger             String
  sentiment           String?
  angerScore          Int      @default(0)
  confidenceScore     Int      @default(100)
  frustrationScore    Int      @default(0)
  summary             String   @default("")
  lastCustomerMessage String   @default("")
  assignedTo          String?
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  resolvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([conversationId, status])
  @@index([customerId, createdAt])
}

model EscalationTimeline {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  kind      String   // created | notified | acknowledged | human_active | resolved | note
  actor     String   @default("system") // system | admin | ai
  message   String
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
}

model UsageLedger {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String?
  kind           String   // messages | ai | broadcast
  quantity       Int      @default(1)
  source         String   // whatsapp | chat | followup | broadcast | admin
  reason         String   @default("")
  idempotencyKey String   @unique
  conversationId String?
  messageId      String?
  customerId     String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([conversationId, createdAt])
}

model UsageDailySnapshot {
  id          String   @id @default(cuid())
  userId      String
  day         String   // YYYY-MM-DD UTC
  messages    Int      @default(0)
  aiRequests  Int      @default(0)
  broadcasts  Int      @default(0)
  ledgerHash  String   @default("")
  verified    Boolean  @default(true)
  mismatch    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model FollowUpTask {
  id             String   @id @default(cuid())
  userId         String
  customerId     String
  conversationId String?
  kind           String   @default("smart_nudge") // price_question | product_view | abandoned_conversation | pending_order
  status         String   @default("queued") // queued | processing | sent | skipped | failed | converted
  dueAt          DateTime
  priority       Int      @default(0)
  reason         String   @default("")
  context        String   @default("{}")
  generatedText  String?
  attempts       Int      @default(0)
  maxAttempts    Int      @default(2)
  idempotencyKey String   @unique
  lastError      String?
  sentAt         DateTime?
  skippedAt      DateTime?
  failedAt       DateTime?
  convertedAt    DateTime?

  // ---- Phase D: Follow-up analytics ----
  repliedAt         DateTime?              // when customer replied after this followup was sent
  revenueImpact     Int      @default(0)  // order value if this followup led to conversion (EGP)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, dueAt])
  @@index([userId, status, dueAt])
  @@index([customerId, status])
}

// ---------------------------------------------------------------------------
// Memory Graph (Agent 1 — Task 3). Append-only edges between the entities the
// memory extractor already identifies (products, objections) and outcomes
// (won / lost). A sibling of the rolling-summary extractor in lib/memory.ts —
// it NEVER modifies CustomerMemory; it only writes here. Powers merchant-facing
// correlations like "اعتراض الشحن يسبق 60% من الصفقات الضائعة".
//
// Edge model: (subjectType, subjectKey) --relation--> (objectType, objectKey)
// scoped per merchant (userId) and per customer. Re-extraction upserts on the
// natural key and bumps `weight`, so the table stays bounded per customer.
// ---------------------------------------------------------------------------
model MemoryEdge {
  id          String   @id @default(cuid())
  userId      String                       // merchant — strict per-tenant scoping
  customerId  String                       // the conversation this edge came from
  subjectType String                       // "customer" | "objection" | "product"
  subjectKey  String                       // normalized key (e.g. "shipping", "<customerId>")
  relation    String                       // "raised" | "interested_in" | "preceded_outcome"
  objectType  String                       // "objection" | "product" | "outcome"
  objectKey   String                       // normalized key (e.g. "lost", "won", "price")
  weight      Int      @default(1)          // times this edge was observed
  lastContext String?                       // short Arabic evidence snippet (optional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, customerId, subjectType, subjectKey, relation, objectType, objectKey])
  @@index([userId, subjectType, subjectKey])
  @@index([userId, objectType, objectKey])
  @@index([userId, relation])
}

model DailyReportDelivery {
  id             String   @id @default(cuid())
  userId         String
  reportDay      String
  channel        String   @default("whatsapp") // whatsapp | email | dashboard
  recipient      String
  status         String   @default("queued") // queued | sending | sent | failed
  attempts       Int      @default(0)
  body           String   @default("")
  error          String?
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, reportDay])
  @@index([status, nextAttemptAt])
}

model ProtectionLog {
  id         String   @id @default(cuid())
  userId     String
  customerId String?
  phone      String?
  kind       String   // flood | spam | abuse | loop | suspicious | ban | unban
  action     String   // observed | throttled | blocked | banned | unbanned
  severity   String   @default("info") // info | warn | critical
  score      Int      @default(0)
  reason     String   @default("")
  payload    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([customerId, createdAt])
}

model BanEvent {
  id          String   @id @default(cuid())
  userId      String
  customerId  String?
  phone       String?
  status      String   @default("active") // active | lifted
  reason      String
  severity    String   @default("warn")
  liftedAt    DateTime?
  liftedBy    String?
  createdAt   DateTime @default(now())

  @@index([userId, status, createdAt])
  @@index([customerId, status])
}

// ---------------------------------------------------------------------------
// Lightweight observability (Controlled Launch).
//
// MetricEvent: per-day, per-event counter. Designed for ~10-20 event kinds
// (llm_call, llm_fail, cache_hit, semantic_hit, quick_reply_hit, fast_path_hit,
// realism_active, anti_ban_cooldown, order_extracted, etc.). Keep cardinality
// LOW — a thousand rows/day is fine, a million is not.
//
// The (userId, day, kind) composite is unique so writers can upsert with
// `count: { increment: 1 }`. `userId="*"` reserved for global counters.
// ---------------------------------------------------------------------------
model MetricEvent {
  id        String   @id @default(cuid())
  userId    String                  // "*" = global
  day       String                  // "YYYY-MM-DD" (UTC) — string for portable group-by
  kind      String                  // event class: see lib/metrics.ts
  count     Int      @default(0)
  lastAt    DateTime @default(now())

  @@unique([userId, day, kind])
  @@index([day, kind])
  @@index([userId, day])
}

// ProviderUsage: per-day, per-user, per-provider aggregate. Foundation for
// future billing. Token counts are best-effort (some providers omit usage).
model ProviderUsage {
  id           String   @id @default(cuid())
  userId       String
  day          String                  // "YYYY-MM-DD" UTC
  provider     String                  // keyone | openai | gemini | openrouter | claude | groq
  model        String   @default("")   // optional resolved model id
  calls        Int      @default(0)
  failures     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalLatencyMs Int    @default(0)    // sum of measured latencies (for avg = total/calls)
  lastAt       DateTime @default(now())

  @@unique([userId, day, provider, model])
  @@index([userId, day])
  @@index([provider, day])
}

// ---------------------------------------------------------------------------
// ActivationEvent (Activation Funnel) — append-only milestone ledger.
//
// Records, at most once per (user, milestone), the FIRST time a merchant
// reaches a step on the signup→value journey. Powers the dashboard activation
// checklist and the admin funnel drop-off view. The @@unique makes recording
// idempotent (first occurrence wins, so `at` = time-to-first-X). See
// lib/activation/track.ts. Kept in sync with schema.prisma (sqlite).
// ---------------------------------------------------------------------------
model ActivationEvent {
  id        String   @id @default(cuid())
  userId    String
  milestone String   // signed_up | onboarding_completed | whatsapp_connected | first_ai_reply_sent | first_order_extracted | first_broadcast_sent
  at        DateTime @default(now())
  metadata  String?  // optional JSON blob (stringified)

  @@unique([userId, milestone])
  @@index([milestone, at])
  @@index([userId, at])
}

// ---------------------------------------------------------------------------
// Safety Engine (Anti-Ban Wave) — persistent state that survives restarts.
//
// One SafetyState row per bot/user. Holds counters, cooldown windows, the
// current warmup stage, the rolling risk score, and kill-switch flags.
// All counters are reset/decayed by the engine — never direct from API.
// ---------------------------------------------------------------------------
model SafetyState {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // ---- Warmup (controls outbound budget for new accounts) ----
  warmupStartedAt     DateTime @default(now())
  warmupStage         String   @default("day1")  // day1 | day2_3 | day4_5 | day6_7 | week2 | mature
  warmupReplyOnly     Boolean  @default(true)    // Day 1-3: bot may only REPLY, never cold outbound
  // ---- Counters (rolled over by engine) ----
  dailySends          Int      @default(0)
  dailySendsResetAt   DateTime @default(now())
  hourlySends         Int      @default(0)
  hourlyResetAt       DateTime @default(now())
  // ---- Rolling risk ----
  riskScore           Int      @default(0)       // 0-100, decays over time
  riskUpdatedAt       DateTime @default(now())
  trustScore          Int      @default(20)      // bot-level trust, grows with healthy activity
  // ---- Cooldown / kill-switch ----
  cooldownUntil       DateTime?
  killSwitchActive    Boolean  @default(false)
  killSwitchReason    String?
  killSwitchAt        DateTime?
  // ---- Failure tracking (feeds kill-switch) ----
  recentFailures      Int      @default(0)       // failed sends in last hour
  recentReconnects    Int      @default(0)       // disconnect/reconnect cycles in last hour
  failuresResetAt     DateTime @default(now())
  // ---- Stats ----
  totalSends          Int      @default(0)
  totalFailures       Int      @default(0)
  totalCooldowns      Int      @default(0)
  lastSendAt          DateTime?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@index([userId])
}

// SafetyEvent: append-only sliding-window log of every outbound + every
// risk event. Used for burst detection, similarity checks, and the live
// dashboard. The engine purges rows older than 24h on every write.
model SafetyEvent {
  id          String   @id @default(cuid())
  userId      String
  kind        String                          // send | failure | cooldown | warmup_advance | kill | reply | block | report
  customerId  String?
  phone       String?
  replyHash   String?                         // sha1 prefix of outbound body (similarity)
  riskScore   Int?                            // snapshot
  payload     String   @default("{}")         // JSON metadata (reasons, error, etc)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

// ---------------------------------------------------------------------------
// Hybrid WhatsApp — Phase 1 models (additive, opt-in, no QR impact)
// ---------------------------------------------------------------------------

/// Per-customer opt-in / consent tracking for outbound messaging. Required
/// for Meta Cloud API compliance (24h service window + marketing consent).
/// QR mode reads this loosely; Meta mode treats it as a hard gate.
model WaConsent {
  id             String   @id @default(cuid())
  userId         String                                   // merchant
  customerPhone  String                                   // E.164, no "+"
  source         String                                   // inbound_reply | website_form | merchant_upload | imported
  marketingOptIn Boolean  @default(false)                 // explicit marketing opt-in
  serviceOptIn   Boolean  @default(true)                  // implicit when customer messages first
  consentedAt    DateTime @default(now())                 // when opt-in was captured
  lastInboundAt  DateTime?                                // last time customer messaged us (24h window anchor)
  revokedAt      DateTime?                                // STOP/الغاء — never message again
  notes          String   @default("")

  @@unique([userId, customerPhone])
  @@index([userId, revokedAt])
  @@index([userId, lastInboundAt])
}

/// Approved Meta Cloud API message templates. We only know about a template
/// after a successful Graph API sync (Phase 2). Pre-existing templates from
/// the Business Manager dashboard appear here when the sync runs.
model WaTemplate {
  id           String   @id @default(cuid())
  userId       String                                     // merchant
  name         String                                     // template name in Meta dashboard
  language     String   @default("ar")                    // BCP-47, usually "ar" / "en"
  category     String                                     // MARKETING | UTILITY | AUTHENTICATION
  status       String   @default("PENDING")               // APPROVED | PENDING | REJECTED | DISABLED
  components   String   @default("[]")                    // JSON: header/body/buttons schema
  qualityScore String?                                    // GREEN | YELLOW | RED — per template
  rejectReason String?
  lastSyncedAt DateTime @default(now())
  usageCount   Int      @default(0)                       // local counter (resets monthly)

  @@unique([userId, name, language])
  @@index([userId, status])
}

/// Outbound message ledger — single source of truth for delivery state.
/// Every send (QR or Meta) writes one row here. The state machine:
///   queued → sending → sent → delivered → read
///                          → failed (terminal)
///                          → expired (terminal — 24h window blew up)
/// Used for: retries, dead-letter, analytics, duplicate protection.
model WaMessage {
  id             String   @id @default(cuid())
  userId         String                                   // merchant
  provider       String                                   // qr | meta_cloud
  conversationId String?                                  // Conversation.id if known
  customerPhone  String                                   // E.164 destination
  direction      String   @default("outbound")            // outbound | inbound (Meta webhooks)
  kind           String   @default("text")                // text | media | template | reaction
  templateName   String?                                  // when kind=template
  body           String   @default("")                    // for text/template — what we tried to send
  mediaUrl       String?                                  // for media kinds
  status         String   @default("queued")              // queued | sending | sent | delivered | read | failed | expired
  errorCode      String?                                  // Meta error code or QR error tag
  errorDetail    String?
  attempts       Int      @default(0)                     // retry counter
  providerMsgId  String?  @unique                         // Meta wamid or QR msg id — used for status reconciliation
  idempotencyKey String?  @unique                         // optional caller-supplied dedupe key
  queuedAt       DateTime @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?

  @@index([userId, status, queuedAt])
  @@index([userId, customerPhone, queuedAt])
  @@index([userId, provider, status])
}

/// Webhook event ledger — idempotency + dead-letter for Meta Cloud webhooks.
/// Every POST from Meta lands here BEFORE any business logic runs. Replays
/// (Meta retries within 7 days) are detected via the unique `eventId`.
model WaWebhookEvent {
  id           String   @id @default(cuid())
  userId       String?                                    // resolved after parsing (null if WABA unknown)
  source       String   @default("meta_cloud")            // future: other providers
  eventId      String                                     // Meta `id` field — unique per delivery
  eventType    String                                     // messages | statuses | account_alerts | …
  rawBody      String                                     // verbatim JSON for replay/debug
  signatureOk  Boolean  @default(false)                   // X-Hub-Signature-256 check result
  processed    Boolean  @default(false)                   // set true after handler succeeds
  attempts     Int      @default(0)
  lastError    String?
  receivedAt   DateTime @default(now())
  processedAt  DateTime?

  @@unique([source, eventId])
  @@index([userId, receivedAt])
  @@index([processed, receivedAt])
}

/// Compliance audit log — separate from SafetyAudit so we can ship a clean
/// Meta compliance report without leaking unrelated anti-ban telemetry.
/// Examples: 24h-window violation blocked, template send rejected by policy,
/// outbound to revoked consent blocked, quality rating dropped.
model WaComplianceAudit {
  id           String   @id @default(cuid())
  userId       String?
  provider     String                                     // qr | meta_cloud
  severity     String   @default("info")                  // info | warn | block | critical
  category     String                                     // consent | window_24h | template | quality | policy | rate_limit
  action       String                                     // blocked | allowed | downgraded | warned
  customerPhone String?
  title        String
  detail       String   @default("")
  payload      String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, category, createdAt])
}

// SafetyAudit: high-signal security events for the admin dashboard.
// Smaller volume than SafetyEvent; meant to be human-readable.
model SafetyAudit {
  id          String   @id @default(cuid())
  userId      String?                          // null = global
  level       String   @default("info")        // info | warn | critical
  category    String                           // anti_ban | warmup | kill_switch | auth | broadcast
  title       String
  detail      String   @default("")
  payload     String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([level, createdAt])
}

// Singleton row holding site-wide configuration the admin can edit.
model SiteConfig {
  id              String   @id @default("singleton")
  brandName       String   @default("KEYONE")
  brandTagline    String   @default("منصة الذكاء الاصطناعي للأعمال")
  supportWhatsapp String   @default("+201000000000")
  supportEmail    String   @default("support@keyone1.com")
  paymentNote     String   @default("")
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// Growth & Conversion Suite — Phase 1 (additive, self-contained)
// All scope by a scalar `userId` + index (same pattern as SafetyAudit), so no
// existing model's relation list changes. Non-destructive `prisma db push`.
// ===========================================================================

/// Product Catalog — merchant products the AI can surface as WhatsApp cards.
model Product {
  id             String   @id @default(cuid())
  userId         String
  name           String
  imageUrl       String?
  price          Int      @default(0)   // whole EGP
  compareAtPrice Int?                    // optional "was" price
  stock          Int      @default(0)
  description    String?
  category       String?
  productLink     String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  // ---- Catalog sync (Agent 3, Task #10) — additive, nullable ----
  // When a product is imported from a connected store, we record its origin so
  // re-imports update in place (idempotent) instead of duplicating. Manually
  // created products leave these null and are never touched by the importer.
  sku            String?                 // merchant/platform SKU (affinity + cards)
  externalSource String?                 // shopify | woocommerce | salla | zid
  externalId     String?                 // platform product/variant id
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, externalSource, externalId])
  @@index([userId, active])
  @@index([userId, category])
}

/// Coupon / Discount Engine.
model Coupon {
  id           String   @id @default(cuid())
  userId       String
  code         String
  type         String   @default("percent") // percent | fixed
  value        Int      @default(0)          // percent (0-100) or fixed EGP
  expiresAt    DateTime?
  usageLimit   Int?                          // null = unlimited
  usedCount    Int      @default(0)
  offeredCount Int      @default(0)          // times offered (AI/admin)
  oneTime      Boolean  @default(false)      // one redemption per customer
  autoOffer    Boolean  @default(false)      // AI may offer this dynamically
  active       Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  redemptions  CouponRedemption[]

  @@unique([userId, code])
  @@index([userId, active])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  customerId String?
  orderId    String?
  revenue    Int      @default(0) // order value attributed to this redemption (EGP)
  redeemedAt DateTime @default(now())

  @@index([couponId])
  @@index([userId, redeemedAt])
}

/// Internal (admin-only) notes thread inside a conversation. Never sent to the
/// customer. @mentions are captured for Phase 2 routing.
model ConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  customerId     String
  userId         String
  authorId       String?
  authorName     String?
  body           String
  mentions       String   @default("[]") // JSON array of @handles
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

/// Product affinity / cross-sell matrix (Agent 3, Task #9).
/// One row per ordered (productKey -> relatedKey) co-purchase pair per merchant,
/// recomputed by a bounded daily batch from OrderItem history. Read-only feed
/// for the upsell detector + NBA upsell template — never sends anything itself.
/// `productKey` / `relatedKey` are normalized item names (or SKUs when present).
model ProductAffinity {
  id            String   @id @default(cuid())
  userId        String
  productKey    String                 // normalized name/SKU of the anchor item
  productLabel  String                 // human-readable anchor name (display)
  relatedKey    String                 // normalized name/SKU of the complement
  relatedLabel  String                 // human-readable complement name (display)
  coCount       Int      @default(0)   // # orders containing both items
  support       Int      @default(0)   // # orders containing the anchor item
  confidence    Int      @default(0)   // 0-100 = coCount / support
  computedAt    DateTime @default(now())

  @@unique([userId, productKey, relatedKey])
  @@index([userId, productKey, confidence])
  @@index([userId, computedAt])
}

/// Visual automation builder rules (Agent 3, Task #8).
/// Merchant-authored if-this-then-that. Evaluated ONLY in background paths
/// (the classify/score tail + crons), never the blocking reply path. Every
/// action routes through an existing safe path (queueSmartFollowUp, tagging,
/// admin notify). OFF by default; hard per-rule throttle + global per-customer
/// action cap enforced via AutomationActionLog.
model AutomationRule {
  id             String   @id @default(cuid())
  userId         String
  name           String   @default("قاعدة جديدة")
  enabled        Boolean  @default(false)
  // trigger: score_crossed | stage_changed | idle_hours | order_status_changed | cart_abandoned
  triggerType    String
  conditions     String   @default("{}")   // JSON — trigger-specific (metric, op, value, fromStage, toStage, hours, status...)
  // action: queue_follow_up | tag_customer | notify_admin | add_to_segment_broadcast
  actionType     String
  actionConfig   String   @default("{}")   // JSON — action params (tag, message hint, delayHours, segment...)
  throttleSeconds Int     @default(86400)  // min seconds between two fires of THIS rule for the SAME customer
  lastFiredAt    DateTime?
  fireCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs           AutomationActionLog[]

  @@index([userId, enabled])
  @@index([userId, triggerType, enabled])
}

/// Append-only audit + throttle ledger for automation rule fires. Used both for
/// merchant visibility ("what fired and why") and to enforce the per-rule /
/// per-customer anti-spam caps before an action is taken.
model AutomationActionLog {
  id          String   @id @default(cuid())
  userId      String
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  customerId  String?
  actionType  String
  status      String   @default("fired")  // fired | throttled | capped | skipped | failed
  detail      String?
  firedAt     DateTime @default(now())

  @@index([ruleId, customerId, firedAt])
  @@index([userId, firedAt])
  @@index([userId, customerId, firedAt])
}

/// AuditLog: append-only record of sensitive workspace actions (Agent 5 —
/// Enterprise & Security). Distinct from SafetyAudit (anti-ban) and
/// WaComplianceAudit (messaging policy). Scoped by `userId` (the workspace
/// owner) so owners/admins can review "who on my team did what".
/// SECURITY: `metadata` is JSON and MUST be redacted — never store secrets,
/// tokens, API keys, or message bodies. Additive table; existing flows ignore
/// it (the emitter is best-effort and never blocks an action).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String                      // workspace owner — data scope
  actorId    String?                     // principal who acted (User.id or TeamMember.id)
  actorEmail String?                     // principal email at action time
  actorRole  String   @default("owner")  // owner | admin | sales | support | viewer
  action     String                      // e.g. team.role_changed, order.updated
  targetType String?                     // e.g. order | broadcast | integration | member
  targetId   String?
  metadata   String   @default("{}")     // JSON; redacted — never secrets
  ip         String?
  at         DateTime @default(now())

  @@index([userId, at])
  @@index([userId, action, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Premium modules (ALL additive; new tables only; no existing model
// altered). Every column has a safe default so the migration is non-breaking.
// ─────────────────────────────────────────────────────────────────────────────

/// Visual automation flow (Flow Builder). The graph (nodes + edges) is stored
/// as JSON in `graphJson` so the schema never changes as the builder evolves.
model FlowDefinition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  enabled     Boolean  @default(false)
  trigger     String   @default("message_received") // message_received | keyword | order_created | manual
  graphJson   String   @default("{\"nodes\":[],\"edges\":[]}")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, enabled])
}

/// Physical/logical business branch (Multi-Branch Management). Lets a merchant
/// route conversations, orders, and reporting per location.
model Branch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  code        String   @default("")
  phone       String?
  address     String?
  city        String?
  managerName String?
  isDefault   Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, enabled])
}

/// A request that needs approval before an action executes (Approval Workflows).
/// e.g. a broadcast or a discount must be approved by an owner/admin first.
model ApprovalRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType   String    // broadcast | order | coupon | refund | custom
  targetId     String?
  title        String
  details      String    @default("")
  amount       Float?
  status       String    @default("pending") // pending | approved | rejected
  requestedBy  String    @default("")        // member/owner email
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
  @@index([userId, targetType, status])
}

/// Per-tenant branding (White Label). One row per user; toggled on for
/// Enterprise. Drives the public/app brand surface for that tenant.
model WhiteLabelConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(false)
  brandName    String   @default("")
  logoUrl      String?
  faviconUrl   String?
  primaryColor String   @default("#6872d4")
  accentColor  String   @default("#6872d4")
  supportEmail String?
  supportPhone String?
  customDomain String?
  hideKeyone   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Self-serve upgrade requests (Phase 4). A merchant asks to move to a plan;
/// an admin activates it (no external payment processor wired yet).
model UpgradeRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromSlug     String    @default("")
  toSlug       String
  billingCycle String    @default("monthly") // monthly | yearly
  status       String    @default("pending") // pending | activated | rejected | canceled
  note         String?
  contactPhone String?
  handledBy    String?
  handledAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}
