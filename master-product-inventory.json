    "admin_visibility_rules": [
      {
        "id": "admin_all_always",
        "name": "Admin sees all features",
        "description": "All features are visible to admins regardless of status",
        "logic": "adminVisible = true (always)"
      },
      {
        "id": "admin_feature_type",
        "name": "Admin feature type",
        "description": "Features marked as admin_feature are visible to admins only",
        "logic": "type = 'admin_feature' AND adminVisible = true AND customerVisible = false"
      }
    ],
    "customer_visibility_rules": [
      {
        "id": "customer_plan_gating",
        "name": "Plan-based feature gating",
        "description": "Customer can see features where minimumPlan <= accountPlan",
        "logic": "customerVisible = true AND minimumPlan <= userPlan"
      },
      {
        "id": "customer_not_admin_features",
        "name": "Hide admin-only features",
        "description": "Admin-only features are not shown to regular customers",
        "logic": "type != 'admin_feature' OR (type = 'admin_feature' AND customerVisible = true)"
      },
      {
        "id": "customer_active_status",
        "name": "Show active and coming soon features",
        "description": "Only active and coming_soon features are visible; beta, disabled, deprecated are gated",
        "logic": "status IN ('active', 'coming_soon')"
      },
      {
        "id": "customer_subfeature_with_parent",
        "name": "Subfeatures follow parent visibility",
        "description": "Subfeatures are only visible if parent feature is visible",
        "logic": "type != 'subfeature' OR (parentFeature exists AND parentFeature is visible)"
      }
    ],
    "implementation_gating": [
      {
        "id": "route_guard",
        "name": "Route-level feature guard",
        "description": "Routes are protected by feature visibility check before rendering",
        "check_point": "middleware",
        "logic": "isFeatureEnabled(featureId) && isCustomerVisible() || isAdmin()"
      },
